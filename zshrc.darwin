# macOS-specific configuration (Apple silicon and Intel Homebrew).
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Legacy asdf installs need sourcing; current asdf uses shims directly.
if [[ -n $HOMEBREW_PREFIX && -f $HOMEBREW_PREFIX/opt/asdf/libexec/asdf.sh ]]; then
  source "$HOMEBREW_PREFIX/opt/asdf/libexec/asdf.sh"
fi
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools"

if [[ -n $HOMEBREW_PREFIX && -d $HOMEBREW_PREFIX/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home ]]; then
  export JAVA_HOME="$HOMEBREW_PREFIX/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
  export PATH="$JAVA_HOME/bin:$PATH"
fi

# macOS provides ssh-agent; ~/.ssh/config handles Keychain and key loading.

# Docker Desktop otherwise appends a machine-specific path to the shared zshrc.
[[ -d "$HOME/.docker/completions" ]] && fpath=("$HOME/.docker/completions" $fpath)
