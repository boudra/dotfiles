[core]
  excludesfile = ~/.gitignore
  editor = nvim
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[diff]
  tool = nvimdiff
  colorMoved = zebra
[difftool]
  prompt = false
[push]
  default = simple
[alias]
  co = checkout
  ci = commit
  st = status
  br = branch
  grame = "!r() { git grep -n $1 $2 | while IFS=: read i j k; do git blame -f -L $j,$j $i; done }; r"
[rerere]
  enabled = 1
  autoupdate = true
[core]
  hooksPath =  /dev/null
[pull]
  rebase = false
[fetch]
  prune = true
[init]
  defaultBranch = main
[help]
	autocorrect = prompt
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

# Identity and machine-local overrides stay outside this public repository.
[include]
  path = ~/.gitconfig.local
